# Physical phone on same Wi‑Fi (alternative hosts):
# EXPO_PUBLIC_WEBSITE_URL=http://192.168.1.10:3000
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api

# Production (baked into APK via config/release-env.js — do not put LAN URLs here for release):
# EXPO_PUBLIC_API_URL=https://back.nuxapp.de/api
# EXPO_PUBLIC_WEBSITE_URL=https://nuxapp.de

# --- Firebase (Google Sign-In + FCM push via expo-notifications)
# 1. Create Firebase project → add Android app package `com.nuxapp.app`
# 2. Add release SHA-1: `npm run keystore:sha1` (after `npm run keystore:generate`)
# 3. Download `google-services.json` → place in mobile_app_new/
# 4. Firebase Console → Authentication → Sign-in method → Google → enable
# 5. Web client ID (same as backend GOOGLE_CLIENT_ID):
# EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
# iOS only — from GoogleService-Info.plist CLIENT_ID:
# EXPO_PUBLIC_FIREBASE_IOS_CLIENT_ID=yyyyy.apps.googleusercontent.com
# iOS prebuild URL scheme — REVERSED_CLIENT_ID from GoogleService-Info.plist:
# FIREBASE_IOS_URL_SCHEME=com.googleusercontent.apps.yyyyy

# --- Google Maps (react-native-maps)
# GOOGLE_MAPS_API_KEY=AIza...

# --- Local release build (no EAS)
# npm run keystore:generate    # once — creates android/app/nux-release.keystore
# npm run build:android:release  # bumps versionCode + prebuild + signed APK

# --- GitHub Actions: ANDROID_KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# Monorepo workflow: .github/workflows/mobile-android-apk.yml
